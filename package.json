{
  "name": "parcel-path",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Track a Canada Post parcel and see its route and a predicted path on a map.",
  "scripts": {
    "setup:browser": "playwright install chromium",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "test": "vitest run",
    "update:facilities": "node scripts/update-facilities.mjs",
    "check:api": "node scripts/check-canada-post.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}

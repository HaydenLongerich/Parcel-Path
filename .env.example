# Copy this file to .env.local and fill in your values. Never commit .env.local.
# These stay on the server and are never sent to the browser, so don't prefix them with VITE_.

# From your [Production] app in the Canada Post Developer Portal, under Credentials.
# One key covers Tracking, Rating, Post Office Services and Service Information.
CANADA_POST_API_KEY=
CANADA_POST_API_SECRET=

# Optional: your Canada Post business customer number. Adds Expedited Parcel and uses your account rates.
# CANADA_POST_CUSTOMER_NUMBER=

# Optional: from a separate [Test] app. Used by the Test bench, and returns Canada Post's sample data.
# CANADA_POST_TEST_API_KEY=
# CANADA_POST_TEST_API_SECRET=

